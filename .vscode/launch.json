{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Python Debugger: Current File",
			"type": "debugpy",
			"request": "launch",
			"program": "${file}",
			"console": "integratedTerminal",
			"justMyCode": false
		},
		{
			"type": "node",
			"request": "launch",
			"name": "Debug Check-Artifacts Action",
			"program": "${workspaceFolder}/.github/actions/check_artifacts/src/index.ts",
			"preLaunchTask": "build-check-artifacts",
			"outFiles": [
				"${workspaceFolder}/out/**/*.js"
			]
		},
		{
			"name": "Python Debugger: Process Path Filter",
			"type": "debugpy",
			"request": "launch",
			"program": "${workspaceFolder}/scripts/process_path_filter.py",
			"console": "integratedTerminal",
			"env": {
				"FILTER_FILE": "${workspaceFolder}/scripts/filter-example.yaml",
				"GITHUB_OUTPUT": "/tmp/github_output.txt",
				"GITHUB_ENV": "/tmp/github_env.txt",
				"GITHUB_STEP_SUMMARY": "/tmp/github_step_summary.txt"
			}
		},
		{
			"name": "Attach to Python Functions",
			"type": "debugpy",
			"request": "attach",
			"connect": {
				"host": "localhost",
				"port": 9091
			},
			"preLaunchTask": "func: host start"
		},
		{
			"name": "Webhook2",
			"type": "debugpy",
			"request": "launch",
			"module": "uvicorn",
			"args": [
				"main2:app",
				"--reload",
				"--host",
				"0.0.0.0",
				"--port",
				"7071",
				"--log-level",
				"debug"
			],
			"envFile": "${workspaceFolder}/webhook2/.env",
			"env": {
				"OTEL_PYTHON_DISABLED_INSTRUMENTATIONS": "psycopg2"
			},
			"console": "integratedTerminal",
			"cwd": "${workspaceFolder}/webhook2",
			"justMyCode": false
		}
	]
}